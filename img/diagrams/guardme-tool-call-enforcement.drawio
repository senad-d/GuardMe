<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.1.5">
  <diagram id="guardme-enforcement" name="Tool-call safety gate">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1160" pageHeight="1200" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="eyebrow" value="GUARDME  /  01  /  TOOL-CALL SAFETY" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1080" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="title" value="A safety gate before the tool runs" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=32;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1080" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="GuardMe checks the agent’s requested action — not the user’s prompt or the LLM API request." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="137" width="1080" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;Pi agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;Proposes a shell or file action" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#172033;align=left;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="hook" value="&lt;b&gt;GuardMe intercepts Pi’s tool_call event&lt;/b&gt;&lt;br&gt;&lt;br&gt;bash · read · write · edit · grep · find · ls + configured tool aliases" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#172033;align=left;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="440" y="220" width="680" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="policy" value="&lt;b&gt;Policy inputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Built-in defaults&lt;br&gt;+ global YAML&lt;br&gt;+ trusted project YAML&lt;br&gt;&lt;br&gt;Rules are combined.&lt;br&gt;A local allow cannot override&lt;br&gt;a deny or hard protection.&lt;br&gt;&lt;br&gt;Missing files? Defaults still apply." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#172033;align=left;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="395" width="300" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="checks" value="&lt;b&gt;Inspect the action and apply deny-first policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Paths&lt;/b&gt; — resolve targets and their actions; protect credentials,&lt;br&gt;protected files and project boundaries.&lt;br&gt;&lt;br&gt;&lt;b&gt;Shell&lt;/b&gt; — check every executable segment, including wrappers,&lt;br&gt;redirections, local scripts and package scripts.&lt;br&gt;&lt;br&gt;&lt;b&gt;File content&lt;/b&gt; — scan command-bearing write/edit payloads.&lt;br&gt;&lt;br&gt;Allow rules never bypass denials or required path permissions." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#172033;align=left;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="440" y="395" width="680" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="deny" value="&lt;b&gt;BLOCK&lt;/b&gt;&lt;br&gt;&lt;br&gt;A deny or protection matched,&lt;br&gt;or required path access is missing.&lt;br&gt;&lt;br&gt;No approval bypass. Tool does not run." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#881337;align=left;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="330" height="205" as="geometry"/>
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;WARN / REVIEW&lt;/b&gt;&lt;br&gt;&lt;br&gt;An eligible risky or unknown action.&lt;br&gt;First block + coach; an identical&lt;br&gt;repeat uses the approval mode.&lt;br&gt;&lt;br&gt;See diagram 02 for the retry flow." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#78350F;align=left;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="415" y="810" width="330" height="205" as="geometry"/>
        </mxCell>
        <mxCell id="allow" value="&lt;b&gt;ALLOW&lt;/b&gt;&lt;br&gt;&lt;br&gt;All applicable checks passed,&lt;br&gt;including any required approval.&lt;br&gt;&lt;br&gt;Pi may run the tool and return&lt;br&gt;its result to the agent." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#064E3B;align=left;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="790" y="810" width="330" height="205" as="geometry"/>
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;Scope matters&lt;/b&gt;   This view assumes GuardMe is active. Off bypasses enforcement in a trusted project.&lt;br&gt;Insecure edits skips only write/edit content scanning; path checks still apply.&lt;br&gt;Unmapped tools, user ! / !! commands, other processes and LLM API traffic are outside this gate.&lt;br&gt;&lt;b&gt;GuardMe is not an OS sandbox.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Helvetica;fontSize=17;fontColor=#475569;align=left;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="1080" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="agent-hook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="agent" target="hook">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="275"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="hook-checks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="hook" target="checks">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="365"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="policy-checks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;dashed=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="policy" target="checks">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="540"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="checks-deny" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BE123C;strokeWidth=2;endArrow=block;endFill=1;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="checks" target="deny">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="542" y="735"/><mxPoint x="205" y="735"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="checks-review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B45309;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="checks" target="review">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="770"/><mxPoint x="580" y="770"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="checks-allow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#047857;strokeWidth=2;endArrow=block;endFill=1;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="checks" target="allow">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1018" y="735"/><mxPoint x="955" y="735"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
